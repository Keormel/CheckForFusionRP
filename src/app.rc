#include <windows.h>

// Встраиваем манифест (запрос прав администратора + DPI awareness).
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// Иконка приложения (самый младший ID = иконка в Проводнике, на панели задач,
// в заголовке окна и в Alt-Tab). Многоразмерная (16–256).
1 ICON "app.ico"
